# Supabase project settings → API. Both values are safe to ship in the client:
# the anon key is public by design and every table is guarded by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# NEVER put the service_role key here -- it bypasses RLS entirely.
# It belongs in Supabase Edge Function secrets and GitHub Actions secrets only.
